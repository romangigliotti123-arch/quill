<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Quill</string>
    <key>CFBundleDisplayName</key>
    <string>Quill</string>
    <key>CFBundleExecutable</key>
    <string>Quill</string>
    <key>CFBundleIdentifier</key>
    <string>com.romangigliotti.quill</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.8</string>
    <key>CFBundleVersion</key>
    <string>9</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>LSMinimumSystemVersion</key>
    <string>26.0</string>

    <!-- Menu-bar-only app: no Dock icon, no menu bar takeover. The overlay HUD
         depends on this to avoid stealing focus from whatever you're typing in. -->
    <key>LSUIElement</key>
    <true/>

    <!-- TCC prompts. Missing strings = instant crash on first access, not a denial. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Quill listens while you hold the dictation key, and transcribes on this Mac.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Quill transcribes your speech entirely on this Mac. Nothing is sent anywhere.</string>
</dict>
</plist>
