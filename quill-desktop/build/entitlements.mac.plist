<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The microphone, which is the whole app. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- onnxruntime compiles kernels at load, and the hardened runtime refuses
       writable-executable memory without this. Without it the transcriber does
       not start and the failure names a memory page, not a model. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- The uiohook binary is signed separately from the app, or not at all. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
